<UserControl x:Class="RentalClient.UserControls.MainWindowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RentalClient"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Margin="20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <Label Grid.Column="0" 
                   Content="House Find" 
                   Style="{StaticResource LogoLabelStyle}" 
                   VerticalAlignment="Center">
                <Label.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding HomeCommand}" />
                </Label.InputBindings>
            </Label>
            
            <TextBox Grid.Column="1" 
                     Style="{StaticResource RoundTextBoxStyle}" 
                     Tag="ПОШУК ЗА МІСТОМ/АДРЕСОЮ..."
                     HorizontalAlignment="Stretch" VerticalContentAlignment="Center" 
                     Margin="30,0" 
                     local:Designer.IsMonitoring="True" />
            
            <Button Grid.Column="2" 
                    Content="Профіль" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Command="{Binding ProfileCommand}" 
                    VerticalAlignment="Center" />
        </Grid>
        
        <ContentControl Grid.Row="1" Content="{Binding CurrentWorkplaceView}" />
    </Grid>
</UserControl>