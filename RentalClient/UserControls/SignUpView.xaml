<UserControl x:Class="RentalClient.UserControls.SignUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:RentalClient"
             xmlns:core="clr-namespace:RentalClient.Core"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundGradientBrush}">
    
    <UserControl.Resources>
        <core:MultiConverter x:Key="MultiConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <Button Grid.Row="0" 
                Content="Back"
                Style="{StaticResource PrimaryButtonStyle}" 
                HorizontalAlignment="Left" 
                Command="{Binding BackToMainWindowCommand}" />
        
        <Border Grid.Row="1" 
                Style="{StaticResource AuthCardBorderStyle}" 
                Width="500" Height="600" 
                Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
            
                <Label Grid.Row="0" Content="Реєстрація" Style="{StaticResource AuthTitleLabelStyle}" />
                
                <TextBox Grid.Row="1" Tag="Ім'я" Style="{StaticResource AuthTextBoxStyle}" 
                         Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" core:Designer.IsMonitoring="True"/>
                
                <TextBox Grid.Row="2" Tag="Email" Style="{StaticResource AuthTextBoxStyle}" 
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" core:Designer.IsMonitoring="True"/>
                
                <TextBox Grid.Row="3" Tag="Телефон" Style="{StaticResource AuthTextBoxStyle}" 
                         Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" core:Designer.IsMonitoring="True"/>
                
                <PasswordBox Grid.Row="4" x:Name="PasswordBox" Tag="Введіть пароль" 
                             Style="{StaticResource BasePasswordBoxStyle}" core:Designer.IsMonitoring="True"
                             PasswordChanged="PasswordBox_PasswordChanged"/>
                
                <PasswordBox Grid.Row="5" x:Name="PasswordConfirmationBox" Tag="Підтвердіть пароль" 
                             Style="{StaticResource BasePasswordBoxStyle}" core:Designer.IsMonitoring="True"
                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                
                <TextBlock Grid.Row="6" Text="{Binding PasswordErrorMessage}" 
                           Foreground="#D9534F" FontWeight="SemiBold" FontSize="12" 
                           HorizontalAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap"/>
                
                <Button Grid.Row="7" Content="Зареєструватися" Margin="0,15,0,10" Command="{Binding RegisterCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#6c757d" /> 
                                    <Setter Property="Foreground" Value="#cfcfcf" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <TextBlock Grid.Row="8" Text="Вже є акаунт? Увійти" Style="{StaticResource ActionLinkTextStyle}" 
                           VerticalAlignment="Bottom">
                    <TextBlock.InputBindings>
                        <MouseBinding Gesture="LeftClick" Command="{Binding SwitchSignCommand}" />
                    </TextBlock.InputBindings>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>